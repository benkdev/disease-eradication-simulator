{
  "name": "the-last-disease",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tld/web dev",
    "test": "pnpm --filter @tld/engine test",
    "test:engine": "pnpm --filter @tld/engine test",
    "test:web": "pnpm --filter @tld/web test",
    "test:unit": "pnpm test:engine && pnpm test:web",
    "test:e2e": "pnpm --filter @tld/web test:e2e",
    "typecheck": "pnpm -r run typecheck",
    "allure:generate": "pnpm --filter @tld/web allure:generate",
    "allure:open": "pnpm --filter @tld/web allure:open",
    "build": "pnpm -r build",
    "deploy": "powershell -ExecutionPolicy Bypass -File infra/deploy.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  }
}
