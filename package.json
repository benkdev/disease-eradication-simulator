{
  "name": "the-last-disease",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm --filter @tld/web dev\" \"pnpm --filter @tld/api dev\"",
    "test": "pnpm --filter @tld/engine test",
    "test:engine": "pnpm --filter @tld/engine test",
    "test:web": "pnpm --filter @tld/web test",
    "build": "pnpm -r build",
    "deploy": "powershell -ExecutionPolicy Bypass -File infra/deploy.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  }
}
